\"state\": {\n              \"type\": \"missing\"\n            }\n          },\n          \"apps/.gitignore\": {\n            \"location\": \"apps/.gitignore\",\n            \"state\": {\n              \"type\": \"missing\"\n            }\n          },\n          \"apps/amended/.gitignore\": {\n            \"location\": \"apps/amended/.gitignore\",\n            \"state\": {\n              \"type\": \"missing\"\n            }\n          },\n          \"apps/new/.gitignore\": {\n            \"location\": \"apps/new/.gitignore\",\n            \"state\": {\n              \"type\": \"missing\"\n            }\n          },\n          \"apps/old/.gitignore\": {\n            \"location\": \"apps/old/.gitignore\",\n            \"state\": {\n              \"type\": \"missing\"\n            }\n          }\n        }\n      },\n      \"changedPaths\": [],\n      \"boundaryChanges\": [],\n      \"violations\": []\n    }\n  ],\n  \"operations\": [],\n  \"retryHistory\": [],\n  \"lastComplete\": {\n    \"run\": \"6d49b398-fa15-4697-a709-49bdce887608\",\n    \"inspection\": \"sha256:fa120d203b709eff18687cf045ac966a186d0cff618960d02ed9e903821dbdc2\",\n    \"completedAt\": \"2026-09-14T08:21:15.729Z\",\n    \"head\": \"c6070ba928b82d8dc7bd59e1f1519b75106e416a\"\n  },\n  \"baselines\": {\n    \"AGENTS.md\": {\n      \"sha256\": \"0c1116331d2e29d508131a934726e3c5c2ce2b212ce56fe5db1868ee9e60a7c0\",\n      \"executable\": false\n    },\n    \".agents/skills/adopt-standards/SKILL.md\": {\n      \"sha256\": \"6508d7acca0ced142bb198b85b8fd194d71901b35bb865f21e4ea9c3ea52fd54\",\n      \"executable\": false\n    }\n  },\n  \"skills\": {\n    \".agents/skills/adopt-standards\": [\n      \"SKILL.md\"\n    ]\n  },\n  \"checks\": [],\n  \"assessments\": [\n    {\n      \"format\": \"repo-standards/assessment/v2\",\n      \"run\": \"6d49b398-fa15-4697-a709-49bdce887608\",\n      \"selection\": \"sha256:4902d1721e9f22ae99b4f045163123a05b11f14a678fb46daff5dde2b3509830\",\n      \"snapshot\": \"sha256:43bd4627f700f1867b37676e8c06b482b3d441e26c7fca9e50e7d7e9e0afb171\",\n      \"scope\": {\n        \"inspection\": \"sha256:fa120d203b709eff18687cf045ac966a186d0cff618960d02ed9e903821dbdc2\",\n        \"afterFixes\": \"sha256:43bd4627f700f1867b37676e8c06b482b3d441e26c7fca9e50e7d7e9e0afb171\"\n      },\n      \"declarations\": [\n        {\n          \"id\": \"docs\",\n          \"status\": \"satisfied\",\n          \"explanation\": \"The existing README content satisfies the focused fixture guidance.\",\n          \"changedPaths\": [],\n          \"evidence\": [\n            \"Reviewed every confirmed README without changing project content.\"\n          ],\n          \"scopeValidity\": {\n            \"afterFixes\": {\n              \"status\": \"valid\",\n              \"explanation\": \"The confirmed projects still match the discovery criteria.\",\n              \"evidence\": [\n                \"Reviewed every confirmed project README.\"\n              ],\n              \"additionalPaths\": []\n            },\n            \"current\": {\n              \"status\": \"valid\",\n              \"explanation\": \"The confirmed projects still match the discovery criteria.\",\n              \"evidence\": [\n                \"Reviewed every confirmed project README.\"\n              ],\n              \"additionalPaths\": []\n            }\n          }\n        }\n      ]\n    }\n  ]\n}\n"
