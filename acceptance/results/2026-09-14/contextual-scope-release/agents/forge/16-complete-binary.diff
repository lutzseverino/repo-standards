--- /dev/null
+++ b/.repo-standards/inputs/source/guidance/project-discovery.md
@@ -0,0 +1,16 @@
+# Project documentation discovery
+
+Identify independently maintained projects from positive ownership and build or
+deployment evidence. A project can require documentation when its directory has
+no README. A familiar filename by itself does not establish membership.
+
+For every candidate, explain inclusion or exclusion. Treat test fixtures,
+generated output, archived copies, and directories that only group teams or
+projects as candidates requiring evidence, not maintained projects by default.
+Leave uncertain maintenance or ownership as an unresolved question.
+
+For each included project, plan individual files for its project README, every
+existing documentation source that will move, each destination and introduced
+documentation index, and every file whose links need repair. Do not include
+`docs/catalog.json`; the source owns that exact file. An explained empty list is
+valid when evidence shows that no maintained project is present.
diff --git a/.repo-standards/inputs/source/guidance/project-documentation.md b/.repo-standards/inputs/source/guidance/project-documentation.md
new file mode 100644
index 0000000000000000000000000000000000000000..97b4d82f4a038e72e2ae9075f3bedf0548b02dfa
--- /dev/null
+++ b/.repo-standards/inputs/source/guidance/project-documentation.md
@@ -0,0 +1,11 @@
+# Project documentation guidance
+
+Give each maintained project a concise README with its purpose, verified setup
+and operating commands, and links to deeper material. Preserve useful facts,
+warnings, and recovery instructions when moving existing documentation into
+`docs/projects/`. Add the smallest useful documentation index and repair links
+that referred to old locations.
+
+Do not rewrite generated or fixture content, invent commands, or describe an
+organizational directory as a project. Preserve project-owned voice and history.
+The exact `docs/catalog.json` is outside this contextual declaration.
diff --git a/.repo-standards/inputs/source/operations/markdown-ending.mjs b/.repo-standards/inputs/source/operations/markdown-ending.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..991e87e0ab415f512de9489140710a82e40b2beb
--- /dev/null
+++ b/.repo-standards/inputs/source/operations/markdown-ending.mjs
@@ -0,0 +1,26 @@
+import { existsSync, lstatSync, readFileSync, writeFileSync } from 'node:fs';
+import { resolve } from 'node:path';
+
+const input = JSON.parse(readFileSync(0, 'utf8'));
+const changed = [];
+const invalid = [];
+
+for (const target of input.allowedTargets.paths) {
+  if (!target.endsWith('.md') || !existsSync(target) || !lstatSync(target).isFile()) continue;
+  const path = resolve(target);
+  const content = readFileSync(path);
+  if (content.length > 0 && content.at(-1) === 0x0a) continue;
+  if (input.operation.phase === 'fixes') {
+    writeFileSync(path, Buffer.concat([content, Buffer.from('\n')]));
+    changed.push(target);
+  } else invalid.push(target);
+}
+
+const failed = input.operation.phase === 'checks' && invalid.length > 0;
+console.log(JSON.stringify({
+  format: 'repo-standards/result/v1',
+  status: failed ? 'failed' : changed.length > 0 ? 'changed' : input.operation.phase === 'checks' ? 'passed' : 'unchanged',
+  message: failed
+    ? `Markdown files without a final newline: ${invalid.join(', ')}`
+    : changed.length > 0 ? `Added final newlines: ${changed.join(', ')}` : 'Markdown endings already satisfy the source.',
+}));
diff --git a/.repo-standards/inputs/standards.yaml b/.repo-standards/inputs/standards.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..acd0b0691f418ab1423d13487cd56e810f7d9302
--- /dev/null
+++ b/.repo-standards/inputs/standards.yaml
@@ -0,0 +1,45 @@
+format: repo-standards/v2
+name: atlas-documentation
+description: Discover maintained projects and keep their documentation navigable
+requires:
+  repo-standards: ">=1.2.0 <2.0.0"
+defaults:
+  declarations: {}
+profiles:
+  maintained:
+    description: Maintained projects whose documentation is organized in one catalog
+    declarations:
+      documentation-catalog:
+        checks: []
+        fixes: []
+        kind: file
+        target: docs/catalog.json
+        exact: files/catalog.json
+      project-documentation:
+        checks:
+          - id: verify-markdown-ending
+            run:
+              executable: node
+              script: operations/markdown-ending.mjs
+              resources: []
+              arguments: []
+            prerequisite:
+              version-arguments:
+                - --version
+              version: ">=24.0.0 <25.0.0"
+            timeout-seconds: 30
+        fixes:
+          - id: normalize-markdown-ending
+            run:
+              executable: node
+              script: operations/markdown-ending.mjs
+              resources: []
+              arguments: []
+            prerequisite:
+              version-arguments:
+                - --version
+              version: ">=24.0.0 <25.0.0"
+            timeout-seconds: 30
+        kind: repository
+        guidance: guidance/project-documentation.md
+        discovery: guidance/project-discovery.md
