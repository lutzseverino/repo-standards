      "encoding": "utf8",
      "content": "{\n  \"format\": \"repo-standards/lock/v1\",\n  \"selection\": {\n    \"cli\": {\n      \"package\": \"@lutzseverino/repo-standards\",\n      \"version\": \"1.1.0\"\n    },\n    \"standards\": {\n      \"repository\": \"https://github.com/lutzseverino/repo-standards-example\",\n      \"version\": \"v1.1.0\",\n      \"commit\": \"fa6e4bc16640e320e6d06496a910cdccb23d9223\"\n    },\n    \"profile\": \"service\"\n  },\n  \"inspection\": \"sha256:84517b9aca7a1c8b489edf7eaa5b0ab18495081f933c90cabaeaff3a47cee497\",\n  \"files\": {\n    \".editorconfig\": {\n      \"sha256\": \"76565420d6347129e8c1b99ae259c764efa836509053365541eacebc5c27e188\",\n      \"executable\": false\n    },\n    \".agents/skills/adopt-standards/SKILL.md\": {\n      \"sha256\": \"2e431b764e59b4a0032353900b8f0e66bcc41a555043cf71c2779b2345c8485f\",\n      \"executable\": false\n    },\n    \".repo-standards/inputs/source/files/editorconfig\": {\n      \"sha256\": \"76565420d6347129e8c1b99ae259c764efa836509053365541eacebc5c27e188\",\n      \"executable\": false\n    },\n    \".repo-standards/inputs/source/guidance/operations.md\": {\n      \"sha256\": \"14ed095ccb26556265776894ef32d2e0c0a1b171e2547a09b12d122a1b9c397c\",\n      \"executable\": false\n    },\n    \".repo-standards/inputs/source/operations/initialize-status.mjs\": {\n      \"sha256\": \"53c0cacb1fbef5eb302885da5672ca3384c5e45819ccc6edce2451b24fad052c\",\n      \"executable\": false\n    },\n    \".repo-standards/inputs/source/operations/check-operations.mjs\": {\n      \"sha256\": \"5c6378a3dc077e981cc80be7e30db408d5dafae4c84295bba95aeb6cde1ead53\",\n      \"executable\": false\n    },\n    \".repo-standards/inputs/source/operations/required-sections.json\": {\n      \"sha256\": \"fc1bde1264915f81b0c7458c82953f8ff456e08fdaaf18347b991261b0a402cd\",\n      \"executable\": false\n    },\n    \".repo-standards/inputs/source/LICENSE\": {\n      \"sha256\": \"95af378c58b45edda9f8113829ee8c2760614789127c829aaa54b247f2d12136\",\n 