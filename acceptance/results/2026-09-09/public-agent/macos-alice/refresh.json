      "executable": false,
      "encoding": "utf8",
      "content": "# Parcel Queue\n\nBob's batch tool previews parcel dispatches for the warehouse shift.\nIt reads newline-delimited JSON from a file, skips already dispatched parcels\nand prints dispatch records to stdout. It does not contact a carrier or persist\nnew dispatch state. Employer review rules are in CONTRIBUTING.md.\n\nRun it with Node. Input examples live under test/.\n"
    },
    ".agents/skills/review": {
      "type": "missing"
    },
    "src": {
      "type": "directory",
      "entries": {
        "cli.mjs": {
          "type": "file",
          "sha256": "4484a9cd1a0184c2dc6bdbf1406ecc66571b20b64e3f49b1a5f1f1864ea4077f",
          "executable": false,
          "encoding": "utf8",
          "content": "import { readFileSync } from 'node:fs';\nimport { pendingDispatches } from './dispatch.mjs';\n\nconst path = process.argv[2];\nif (!path) {\n  console.error('Usage: node src/cli.mjs <parcels.ndjson>');\n  process.exitCode = 2;\n} else {\n  const parcels = readFileSync(path, 'utf8').split('\\n').filter(line => line.trim()).map(line => JSON.parse(line));\n  for (const dispatch of pendingDispatches(parcels)) console.log(JSON.stringify(dispatch));\n}\n"
        },
        "dispatch.mjs": {
          "type": "file",
          "sha256": "d729b0062faa56bff1523e97172d086e682050e1d26d8f9dade1bc536f7d3e59",
          "executable": false,
          "encoding": "utf8",
          "content": "export function pendingDispatches(parcels) {\n  return parcels.filter(parcel => parcel.status === 'ready').map(parcel => {\n    if (typeof parcel.id !== 'string' || !parcel.id) throw new Error('Ready parcels require an id');\n    return { parcelId: parcel.id, action: 'dispatch' };\n  });\n}\n"
        }
      }
    },
