{
  "name": "@lutzseverino/repo-standards",
  "version": "2.0.0",
  "description": "Validate and apply versioned repository standards",
  "license": "MIT",
  "type": "module",
  "bin": {
    "repo-standards": "dist/cli.js",
    "repo-standards-bootstrap": "bootstrap/repo-standards"
  },
  "files": [
    "dist",
    "bootstrap",
    "skills",
    "examples",
    "docs",
    "AGENTS.md",
    "CONTRIBUTING.md",
    "CONTEXT.md"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.20.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lutzseverino/repo-standards.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "validate": "pnpm typecheck && pnpm build && pnpm test",
    "prepack": "pnpm build",
    "release:pack": "pnpm build && node scripts/pack-release.ts"
  },
  "dependencies": {
    "koffi": "3.2.1",
    "semver": "7.8.5",
    "unicode-case-folding": "1.1.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/semver": "7.8.0",
    "typescript": "7.0.2"
  }
}
