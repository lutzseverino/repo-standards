{
  "name": "@lutzseverino/repo-standards",
  "version": "10.0.0",
  "description": "Validate and apply versioned repository standards",
  "license": "MIT",
  "type": "module",
  "bin": {
    "repo-standards": "dist/cli.js",
    "repo-standards-bootstrap": "bootstrap/repo-standards"
  },
  "files": [
    "dist",
    "bootstrap",
    "skills",
    "examples",
    "docs/usage"
  ],
  "engines": {
    "node": ">=24 <25 || >=26 <27"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.20.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/lutzseverino/repo-standards.git"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/lutzseverino"
    },
    {
      "type": "individual",
      "url": "https://ko-fi.com/lutzseverino"
    }
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --plugin prettier-plugin-astro --write .",
    "format:check": "prettier --plugin prettier-plugin-astro --check .",
    "test": "node --test test/*.test.ts",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && node --experimental-vm-modules --disable-warning=ExperimentalWarning scripts/check-import-cycles.ts && pnpm build && pnpm test && pnpm --dir site ui:check && pnpm --dir site check && pnpm --dir site test && pnpm --dir site build:fixture",
    "prepack": "pnpm build",
    "release:pack": "pnpm build && node scripts/pack-release.ts"
  },
  "dependencies": {
    "@lutzseverino/postern": "1.0.0",
    "koffi": "3.2.1",
    "semver": "7.8.5",
    "unicode-case-folding": "1.1.1",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/semver": "7.8.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "prettier-plugin-astro": "1.1.1"
  }
}
