---
// One standards source's own page, for each source search accepts: what it
// is, its latest release, its profiles, what it installs and how to adopt it.
import { Arrow } from "@/components/sign/arrow";
import { Surface } from "@/components/sign/face";
import { SITE_NAV_STRINGS, SiteNav } from "@/components/site-nav";
import {
  SOURCE_ADOPTION_STRINGS,
  SourceAdoption,
} from "@/components/source-adoption";
import { format, rich, strings } from "@/i18n/format";
import type { MessageId } from "@/i18n/ids";
import {
  localeAlternates,
  localeName,
  localeRoutes,
  type Locale,
} from "@/i18n/locales";
import BaseLayout from "@/layouts/base.astro";
import {
  listing,
  repositoryUrl,
  sourcePath,
  type Declaration,
  type DetailedSource,
} from "@/lib/catalogue";
import { formatDate } from "@/lib/format";
import { loadCatalogue } from "@/lib/load-catalogue";
import {
  sourceDescription,
  sourceIntroduction,
  sourceTitle,
} from "@/lib/source-page";
import {
  buildSourceStructuredData,
  serializeStructuredData,
} from "@/lib/structured-data";
import "@/components/sign/sign.css";
import "@/components/adoption-dialog.css";

export async function getStaticPaths() {
  const { sources } = await loadCatalogue();
  return localeRoutes().flatMap(({ params, props }) =>
    sources.map((source) => {
      const [owner, repo] = source.repository.split("/");
      return {
        params: { ...params, owner, repo },
        props: { ...props, source },
      };
    }),
  );
}

type Props = { locale: Locale; source: DetailedSource };

const { locale, source } = Astro.props;
const url = new URL(sourcePath(source), Astro.site).href;
const introduction = sourceIntroduction(source, locale);
const repository = repositoryUrl(source);
// ends each part but the last with its slash
const repositoryText = `github.com/${source.repository}`.split(/(?<=\/)/);
const everyProfile = (d: Declaration) =>
  d.profiles.length === source.profiles.length;
const t = (id: MessageId) => format(locale, id);

const KINDS: Record<Declaration["kind"], MessageId> = {
  file: "sources.kind.file",
  skill: "sources.kind.skill",
  repository: "sources.kind.repository",
};
const release = rich(
  locale,
  "sources.release.value",
  { date: formatDate(source.release.publishedAt, locale) },
  ["version"],
);
const installed = rich(
  locale,
  "sources.installs.text",
  { version: source.release.version },
  ["file"],
);
---

<BaseLayout
  locale={locale}
  title={sourceTitle(source, locale)}
  description={sourceDescription(source, locale)}
>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={serializeStructuredData(buildSourceStructuredData(source, url))}
  />
  <main class="mx-auto max-w-4xl px-6 pt-10 pb-32">
    <SiteNav
      client:load
      locale={locale}
      alternates={localeAlternates(sourcePath(source))}
      language={format(locale, "common.language.current", {
        language: localeName(locale),
      })}
      strings={strings(locale, SITE_NAV_STRINGS)}
    />

    <header>
      <!-- a plate like the adoption dialog's: no torch lights this page, so
           by night it is lit already -->
      <h1 class="sign-face sign-face--blue px-6 pt-5 pb-5 text-[34px] leading-none font-bold [overflow-wrap:anywhere] md:px-8 md:text-[46px] dark:[--face-bg:var(--blue-lit)] dark:[--face-ink:#fff] dark:[--face-line:#fff]">
        <Surface slats />
        <span class="sign-face__inner flex items-center gap-4">
          <Arrow size={44} />
          {source.name}
        </span>
      </h1>
      <p class="mt-6 text-xl leading-snug">{source.description}</p>
      <dl class="mt-5 grid grid-cols-[auto_minmax(0,1fr)] gap-x-6 gap-y-1.5 text-[16px]">
        <dt class="text-muted-foreground">{t("sources.release.label")}</dt>
        <dd>
          {release.map((part, i) =>
            i % 2 === 0 ? (
              part
            ) : (
              <a class="underline underline-offset-4" href={source.release.url}>
                {source.release.version}
              </a>
            ),
          )}
        </dd>
        <dt class="text-muted-foreground">{t("sources.requires.label")}</dt>
        <dd>
          {format(locale, "sources.requires.value", {
            requirement: source.requires.replace(">=", "≥ "),
          })}
        </dd>
        <dt class="text-muted-foreground">{t("sources.repository.label")}</dt>
        <dd>
          <!-- on a phone it breaks after a slash, or anywhere in a long name -->
          <a
            class="underline underline-offset-4 [overflow-wrap:anywhere]"
            href={repository}
          >
            {repositoryText.map((part, i) => (i > 0 ? [<wbr />, part] : part))}
          </a>
        </dd>
      </dl>
    </header>

    {introduction && (
      <section class="mt-12">
        <h2 class="text-2xl font-bold">{t("sources.introduction.heading")}</h2>
        <p class="mt-3 max-w-2xl leading-snug">{introduction.lead}</p>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          {introduction.topics.map((topic) => (
            <div>
              <h3 class="text-lg font-bold">{topic.heading}</h3>
              <p class="mt-1 leading-snug">{topic.text}</p>
              <ul class="mt-2 flex flex-wrap gap-1.5 text-[14px]">
                {topic.items.map((item) => (
                  <li>
                    <code class="rounded bg-muted px-1.5 py-0.5 [overflow-wrap:anywhere]">
                      {item}
                    </code>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="mt-12">
      <h2 class="text-2xl font-bold">
        {format(locale, "sources.adopt.heading", { name: source.name })}
      </h2>
      <p class="mt-3 mb-5 max-w-2xl leading-snug">{t("sources.adopt.text")}</p>
      <SourceAdoption
        client:load
        source={listing(source)}
        strings={strings(locale, SOURCE_ADOPTION_STRINGS)}
      />
      <p class="mt-5 text-[15px] text-muted-foreground">{t("common.notice")}</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold">{t("sources.profiles.heading")}</h2>
      <dl class="mt-4 grid gap-3">
        {source.profiles.map((profile) => (
          <div>
            <dt class="font-bold">{profile.name}</dt>
            <dd class="leading-snug">{profile.description}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold">{t("sources.installs.heading")}</h2>
      <p class="mt-3 max-w-2xl leading-snug">
        {installed.map((part, i) =>
          i % 2 === 0 ? part : <code>standards.yaml</code>,
        )}
      </p>
      <div class="mt-5 overflow-x-auto">
        <table class="w-full text-left text-[15px] leading-snug">
          <thead class="text-muted-foreground">
            <tr>
              <th class="py-2 pr-4 font-medium">
                {t("sources.installs.declaration")}
              </th>
              <th class="py-2 pr-4 font-medium">
                {t("sources.installs.targets")}
              </th>
              <th class="py-2 pr-4 font-medium">
                {t("sources.installs.checks")}
              </th>
              <th class="py-2 font-medium">{t("sources.installs.profiles")}</th>
            </tr>
          </thead>
          <tbody>
            {source.installs.map((d) => (
              <tr class="border-t align-top">
                <td class="py-2 pr-4">
                  <code>{d.id}</code>
                  <div class="text-[14px] text-muted-foreground">
                    {t(KINDS[d.kind])}
                  </div>
                </td>
                <td class="py-2 pr-4 [overflow-wrap:anywhere]">
                  {d.targets.length > 0 ? (
                    d.targets.map((t) => <code class="block">{t}</code>)
                  ) : (
                    <span class="text-muted-foreground">
                      {t("sources.installs.discovered")}
                    </span>
                  )}
                </td>
                <td class="py-2 pr-4">
                  {d.checks.map((c) => (
                    <code class="block">{c}</code>
                  ))}
                </td>
                <td class="py-2">
                  {everyProfile(d)
                    ? t("sources.installs.every-profile")
                    : d.profiles.join(", ")}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  </main>
</BaseLayout>
