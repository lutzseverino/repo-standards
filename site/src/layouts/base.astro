---
// The document and its head for every page outside the docs: the theme,
// applied before anything is drawn, each page's own title, description and
// canonical URL, the Open Graph and Twitter card tags that a link to it
// unfurls with, the favicons, the web manifest and the analytics beacon. A
// page passes its own social image or takes the default one, and adds its own
// head elements, such as JSON-LD, in the `head` slot. After the page comes
// the footer, with the ways to support Repo Standards. `<html lang>` is the
// page's locale, and before anything else the head opens the page in the
// visitor's language.
import AgentLinks from "@/components/AgentLinks.astro";
import { format } from "@/i18n/format";
import type { Locale } from "@/i18n/locales";
import { analyticsBeacon } from "@/lib/analytics";
import { themeScript } from "@/lib/theme-core";
import "@/styles/global.css";
import "@/styles/tokens.css";
import "@/styles/support.css";
// after the stylesheets: Astro orders a page's stylesheets by where they are
// imported, so an import before them moves the layout's stylesheet after the
// page's own, and with it the order of the cascade layers
import LocaleScript from "@/components/LocaleScript.astro";
import SupportLine from "@/components/SupportLine.astro";
import { localeChoice } from "@/i18n/choice";
import { DEFAULT_LOCALE, LOCALES, localeAlternates } from "@/i18n/locales";
import { serializeStructuredData } from "@/lib/structured-data";
import { defaultSocialImage, type SocialImage } from "@/lib/social-image";

type Props = {
  locale: Locale;
  title: string;
  description: string;
  image?: SocialImage;
};

const {
  locale,
  title,
  description,
  image = defaultSocialImage(locale),
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const { path } = localeChoice(LOCALES).page(Astro.url.pathname);
const alternates = localeAlternates(path);
// Open Graph requires language_TERRITORY rather than the site's plain tags.
const ogLocales = { en: "en_US", es: "es_ES", ca: "ca_ES" };
const ogLocale = ogLocales[locale === "en-XA" ? DEFAULT_LOCALE : locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <LocaleScript locale={locale} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    {Object.entries(alternates).map(([language, path]) => (
      <link
        rel="alternate"
        hreflang={language}
        href={new URL(path, Astro.site)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(alternates[DEFAULT_LOCALE], Astro.site)}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Repo Standards" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {LOCALES.filter((other) => other !== locale).map((other) => (
      <meta property="og:locale:alternate" content={ogLocales[other]} />
    ))}
    <meta property="og:image" content={new URL(image.src, Astro.site)} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- the ICO's 32x32 size keeps browsers that read SVG on the SVG -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <AgentLinks />
    <link rel="manifest" href="/site.webmanifest" />
    <script
      type="application/ld+json"
      is:inline
      set:html={serializeStructuredData({
        "@context": "https://schema.org",
        "@type": "WebPage",
        name: title,
        description,
        url: canonical.href,
        inLanguage: locale,
      })}
    />
    <slot name="head" />
    <!-- applies the stored or system theme before anything is drawn -->
    <script is:inline set:html={themeScript()} />
    <script is:inline {...analyticsBeacon.attrs}></script>
  </head>
  <body>
    <slot />
    <footer class="support-footer">
      <SupportLine label={format(locale, "common.support.footer")} />
    </footer>
  </body>
</html>
