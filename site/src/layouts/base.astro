---
// The document and its head for every page outside the docs: the theme,
// applied before anything is drawn, each page's own title, description and
// canonical URL, the favicons and the analytics beacon. A page adds its own
// head elements, such as JSON-LD, in the `head` slot.
import AgentLinks from "@/components/AgentLinks.astro";
import { analyticsBeacon } from "@/lib/analytics";
import { themeScript } from "@/lib/theme-core";
import "@/styles/global.css";
import "@/styles/tokens.css";

type Props = { title: string; description: string };

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <!-- the ICO's 32x32 size keeps browsers that read SVG on the SVG -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <AgentLinks />
    <slot name="head" />
    <!-- applies the stored or system theme before anything is drawn -->
    <script is:inline set:html={themeScript()} />
    <script is:inline {...analyticsBeacon.attrs}></script>
  </head>
  <body>
    <slot />
  </body>
</html>
