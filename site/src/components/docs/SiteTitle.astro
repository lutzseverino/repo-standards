---
// The supported Starlight override for the header's title: the site's plate
// (plate.tsx), linking home. The homepage's light and torch stay on the
// homepage.
import { Plate } from "../plate";

const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<Plate href={siteTitleHref} name={siteTitle} />
