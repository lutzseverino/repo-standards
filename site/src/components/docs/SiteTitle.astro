---
// The supported Starlight override for the header's title: a plain sign
// plate, Verkehrsblau with white legend in the condensed sign face, linking
// home. The homepage's light and torch stay on the homepage.
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="docs-plate" translate="no">
  {siteTitle}
</a>

<style>
  .docs-plate {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    padding: 0.2em 0.55em 0.15em;
    border-radius: 0.3em;
    /* a blue margin, then the plate's white border line */
    box-shadow:
      inset 0 0 0 0.1em var(--verkehrsblau),
      inset 0 0 0 0.2em #fff;
    background: var(--verkehrsblau);
    color: #fff;
    font-family: var(--font-sign);
    font-size: var(--sl-text-xl);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
  }
</style>
