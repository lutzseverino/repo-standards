---
// The supported Starlight override for the header: Starlight's own, then the
// site's one Support control, an island that hydrates once the page has
// settled (lib/settled.ts). Starlight hides its right-hand group below 50rem;
// the control stays at every width.
import Default from "@astrojs/starlight/components/Header.astro";
import { SupportMenu } from "../support";
import "../../styles/docs-components.css";
---

<div class="docs-header">
  <div class="docs-header__stock">
    <Default />
  </div>
  <SupportMenu client:settled />
</div>

<style>
  .docs-header {
    display: flex;
    align-items: center;
    gap: var(--sl-nav-gap);
    height: 100%;
  }
  .docs-header__stock {
    flex: 1;
    min-width: 0;
    height: 100%;
  }
</style>
