---
// The supported Starlight override for the header: Starlight's own, then the
// site's one Support control, an island that hydrates once the page has
// settled (lib/settled.ts). Starlight hides its right-hand group below 50rem;
// the control stays at every width, with its heart alone on a phone so the
// title's plate keeps its whole name. The docs are in English only.
import Default from "@astrojs/starlight/components/Header.astro";
import { strings } from "../../i18n/format";
import { DEFAULT_LOCALE } from "../../i18n/locales";
import { SUPPORT_STRINGS, SupportMenu } from "../support";
import "../../styles/docs-components.css";
---

<div class="docs-header">
  <div class="docs-header__stock">
    <Default />
  </div>
  <SupportMenu
    client:settled
    heartAlone="30rem"
    strings={strings(DEFAULT_LOCALE, SUPPORT_STRINGS)}
  />
</div>

<style>
  .docs-header {
    display: flex;
    align-items: center;
    gap: var(--sl-nav-gap);
    height: 100%;
  }
  .docs-header__stock {
    flex: 1;
    min-width: 0;
    height: 100%;
  }
</style>
