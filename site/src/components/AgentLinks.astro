---
// The same discovery links for the shared layout and Starlight's head.
const pathname = Astro.url.pathname.replace(/\/$/, "").replace(/\.html$/, "");
const markdown = pathname ? `${pathname}.md` : "/index.md";
---

<link rel="alternate" type="text/markdown" href={markdown} />
<link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
