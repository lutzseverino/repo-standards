  "prompt.start.title": {
    "message": "Enganxa'l al teu agent",
    "source": "d20119e2"
  },
  "prompt.start.body": {
    "message": "Obre l'agent al repositori que vols configurar, amb almenys un commit i sense canvis pendents. Serveix qualsevol agent que pugui executar ordres.",
    "source": "b680c7da"
  },
  "prompt.apply.title": {
    "message": "L'agent adopta la configuració",
    "source": "054ae161"
  },
  "prompt.apply.body": {
    "message": "Tria una versió i un perfil i revisa els canvis proposats. Després instal·la els fitxers de la font, adapta el contingut propi del teu projecte i executa les comprovacions de la font.",
    "source": "efe19f0d"
  },
  "prompt.review.title": {
    "message": "Tu revises i fas commit",
    "source": "2bf1d27e"
  },
  "prompt.review.body": {
    "message": "Ningú no fa commit per tu. Revisa els canvis, inclòs qualsevol fitxer que la font hagi substituït, i fes commit com sempre. Per actualitzar més endavant, torna a donar el mateix prompt a l'agent.",
    "source": "443d1ada"
  },
  "terminal.start.title": {
    "message": "Executa-la al teu repositori",
    "source": "18dc930c"
  },
  "terminal.start.body": {
